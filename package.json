{
  "name": "realistic-machine-explainer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Reusable React Three Fiber system for 60-second 9:16 technical explainer videos about everyday machines.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "render": "node scripts/render.mjs",
    "render:preview": "node scripts/render.mjs --every 15 --out out/preview",
    "qa": "node scripts/qa.mjs",
    "export:glb": "node scripts/export-glb.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.1.0",
    "@fontsource/jetbrains-mono": "5.1.1",
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.18.0",
    "@react-three/postprocessing": "2.19.1",
    "postprocessing": "6.37.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.170.0",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "4.3.4",
    "playwright": "1.63.0",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
