{
  "titel": "Folge 1 – Der erste Mensch",
  "konto": "@wasserderErde",
  "stimme": { "typ": "espeak", "stimme": "mb-de6", "tempo": 150 },
  "beats": [
    { "text": "Tag {tag}.", "kamera": "space", "sticker": [{ "typ": "tag" }], "min": 1.3 },
    { "text": "Wir trinken das *gesamte Wasser* der Erde aus.", "kamera": "orbit", "strohhalm": true,
      "sticker": [{ "typ": "schild", "text": "1,386 TRILLIARDEN LITER", "farbe": "weissrot", "y": 22 }] },
    { "text": "Ich bin {blau:Kapitän Durst}.", "kamera": "kapitaen", "aktion": "winken",
      "sticker": [{ "typ": "namensschild", "name": "KAPITÄN DURST", "titel": "Chef-Trinker der Erde" }] },
    { "text": "Und *jeder neue* Follower", "kamera": "kapitaen",
      "sticker": [{ "typ": "schild", "text": "+1 FOLLOWER = 1 MENSCH 🌍", "farbe": "gelb", "y": 14, "drehung": -3 }] },
    { "text": "wird ein {gruen:Mensch} auf der Erde.", "kamera": "europe" },
    { "text": "Gerade lebt hier nur {gruen:{einwohner_text}}.", "kamera": "einwohner1", "uebergang": 2.6, "min": 3,
      "sticker": [{ "typ": "zahl", "label": "EINWOHNER", "von": 0, "bis": "{einwohner}", "farbe": "gruen" }] },
    { "text": "Er trinkt {gruen:zehn Liter} am Tag.", "kamera": "einwohner1",
      "sticker": [{ "typ": "zeiger", "text": "MENSCH NR. 1", "ziel": "einwohner1" },
                  { "typ": "schild", "text": "🥤 10 LITER PRO TAG", "farbe": "gruen", "y": 18, "drehung": 3 }] },
    { "text": "Likes, Kommentare und Shares kosten *extra* Wasser.", "kamera": "africa",
      "sticker": [{ "typ": "info", "y": 20, "zeilen": ["❤️ 1 LIKE = 10 ML", "💬 1 KOMMENTAR = 500 ML", "🔁 1 SHARE = 2 LITER"] }] },
    { "text": "Und das Meer?", "kamera": "northsea",
      "sticker": [{ "typ": "zeiger", "text": "NORDSEE", "lat": 56, "lon": 3 }] },
    { "text": "Noch {blau:randvoll}.", "kamera": "northsea",
      "sticker": [{ "typ": "schild", "text": "NOCH VOLL 🌊", "farbe": "blau", "y": 18, "drehung": 4 }] },
    { "text": "Alleine braucht er dafür {rot:{reicht}}.", "kamera": "pacific",
      "sticker": [{ "typ": "schild", "text": "⏳ {reicht_kurz}", "farbe": "weiss", "y": 20 }] },
    { "text": "Das ist {rot:viel zu langsam!}", "kamera": "kapitaen", "aktion": "trinken",
      "sticker": [{ "typ": "schild", "text": "ZU LANGSAM!", "farbe": "rot", "y": 16, "drehung": -6 }] },
    { "text": "Aber mit euch ...", "kamera": "space", "wasser": { "von": "jetzt", "bis": 0.45 }, "min": 2.4,
      "sticker": [{ "typ": "schild", "text": "MIT EUCH ...", "farbe": "rot", "y": 18 }] },
    { "text": "könnte die Erde *so* aussehen.", "kamera": "space", "wasser": { "von": 0.45, "bis": 0.8 }, "min": 2.6,
      "sticker": [{ "typ": "schild", "text": "VORSCHAU", "farbe": "weissrot", "y": 18 }] },
    { "text": "Also folgt, damit *mehr Menschen* mittrinken!", "kamera": "kapitaen", "aktion": "winken",
      "sticker": [{ "typ": "profil" }] },
    { "text": "Mal sehen, wer {blau:morgen} dazukommt.", "kamera": "space", "strohhalm": true, "min": 3,
      "sticker": [{ "typ": "statistik" }] }
  ]
}
