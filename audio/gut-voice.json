 "segments": [
  {
   "text": "Du furzt bis zu 20 Mal am Tag –",
   "src": [
    0,
    2.653
   ],
   "at": 0.12,
   "tempo": 1.12
  },
  {
   "text": "und jedes Mal prüft dein Körper vorher:",
   "src": [
    2.94,
    5.412
   ],
   "at": 2.529,
   "tempo": 1.12
  },
  {
   "text": "Ist das wirklich nur Gas?",
   "src": [
    5.587,
    7.161
   ],
   "at": 4.776,
   "tempo": 1.12
  },
  {
   "text": "Schauen wir in deinen Bauch:",
   "src": [
    7.534,
    9.091
   ],
   "at": 6.281,
   "tempo": 1.12
  },
  {
   "text": "Magen, Dünndarm, Dickdarm und Enddarm …",
   "src": [
    9.548,
    14.191
   ],
   "at": 7.711,
   "tempo": 1.12
  },
  {
   "text": "Ein Teil des Gases ist verschluckte Luft –",
   "src": [
    14.435,
    17.17
   ],
   "at": 11.957,
   "tempo": 1.12
  },
  {
   "text": "beim Essen, Trinken oder Sprechen.",
