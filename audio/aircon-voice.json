    27.88,
    30.63
   ],
   "at": 31.006,
   "tempo": 0.95
  },
  {
   "text": "Dadurch wird es heißer als die Sommerluft.",
   "src": [
    30.93,
    33.16
   ],
   "at": 34.426,
   "tempo": 0.95
  },
  {
   "text": "Ein Ventilator bläst über das Gitter,",
   "src": [
    33.45,
    35.62
   ],
   "at": 37.295,
   "tempo": 0.95
  },
  {
   "text": "das Gas gibt seine Wärme ab und wird wieder flüssig.",
   "src": [
    35.76,
    38.79
   ],
   "at": 40.05,
   "tempo": 0.95
  },
  {
   "text": "Dann zischt es durch ein enges Ventil,",
   "src": [
    39.09,
    41.3
   ],
   "at": 43.765,
   "tempo": 0.95
  },
  {
   "text": "der Druck fällt, und es wird eiskalt.",
   "src": [
    41.41,
    43.9
   ],
   "at": 46.552,
   "tempo": 0.95
  },
  {
   "text": "Das Überraschende:",
   "src": [
    44.31,
    45.32
   ],
   "at": 49.736,
   "tempo": 0.95
  },
  {
   "text": "Erfunden wurde die Klimaanlage nicht für Menschen,",
   "src": [
    45.58,
    48.43
   ],
   "at": 51.311,
   "tempo": 0.95
  },
  {
   "text": "sondern neunzehnhundertzwei für eine Druckerei –",
