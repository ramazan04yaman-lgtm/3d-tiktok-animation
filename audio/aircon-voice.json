 "segments": [
  {
   "text": "Eine Klimaanlage macht keine Kälte.",
   "src": [
    0,
    2.34
   ],
   "at": 0.1,
   "tempo": 0.95
  },
  {
   "text": "Sie trägt die Wärme aus deinem Zimmer nach draußen.",
   "src": [
    2.66,
    5.28
   ],
   "at": 3.095,
   "tempo": 0.95
  },
  {
   "text": "Der Trick steckt in einem Kältemittel, das durch Rohre kreist.",
   "src": [
    5.76,
    9.03
   ],
   "at": 6.44,
   "tempo": 0.95
  },
  {
   "text": "Drinnen saugt ein Lüfter warme Raumluft über eiskalte Lamellen.",
   "src": [
    9.39,
    13.33
   ],
   "at": 10.428,
   "tempo": 0.95
  },
  {
   "text": "Das Kältemittel darin verdampft und nimmt dabei die Wärme auf –",
   "src": [
    13.7,
    17.2
   ],
   "at": 15.124,
   "tempo": 0.95
  },
  {
   "text": "wie Schweiß auf deiner Haut.",
   "src": [
    17.42,
    18.86
   ],
   "at": 19.306,
   "tempo": 0.95
  },
  {
   "text": "Die feuchte Luft kühlt ab, Wasser kondensiert und tropft heraus.",
   "src": [
    19.27,
    23.35
   ],
   "at": 21.385,
   "tempo": 0.95
  },
  {
   "text": "Wenn du mehr Maschinen von innen sehen willst –",
   "src": [
    23.73,
    25.93
   ],
   "at": 26.232,
   "tempo": 0.95
  },
  {
   "text": "Like und abonnieren.",
   "src": [
    26.04,
    27.37
   ],
   "at": 29.009,
   "tempo": 0.95
  },
  {
   "text": "Draußen presst ein Kompressor das Gas zusammen.",
